# Copy this file to .env.local and fill in your own token (never commit real tokens).

# Mapillary client access token — enables real, walkable street-level imagery
# in the Street perspective. Without it, Street falls back further down the
# chain (Cesium, then a real street map, then the illustrated scene).
#
# Get a free one at: https://www.mapillary.com/dashboard/developers
# (sign in, "Register application", copy the "Client Token", starts with "MLY|")
VITE_MAPILLARY_TOKEN=

# Cesium ion access token — enables a free-roam 3D walkthrough (Cesium World
# Terrain + OSM Buildings) in the Street perspective, used wherever Mapillary
# has no photo coverage. Lower visual fidelity than real photos or Google's
# paid Photorealistic 3D Tiles, but near-global coverage and no billing.
#
# Get a free one at: https://ion.cesium.com/tokens
# (sign up, "Create Token", copy it — starts with "eyJ...")
VITE_CESIUM_ION_TOKEN=

# Pexels API key — enables real stock video footage in the Atmosphere
# perspective (matched to the current weather + time of day + city), in
# place of the illustrated CSS/canvas scene. Without it, Atmosphere stays on
# the illustrated scene automatically.
#
# Get a free one at: https://www.pexels.com/api/
# (sign up, confirm email, your API key is shown immediately — no billing)
VITE_PEXELS_API_KEY=

# Public base URL of the Cloudflare R2 bucket hosting the project author's
# own neighborhood ambiance/street footage (see scripts/README.md). Without
# it, those specific clips fall back the same way a missing local file would.
# This is a public CDN URL, safe to expose — not a secret.
VITE_R2_PUBLIC_URL=

# --- R2 upload credentials (scripts/upload-footage.mjs only, never bundled
# into the client — do NOT prefix these with VITE_) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
